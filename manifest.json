{
    "manifest_version": 3,
    "name": "Breadcrumb",
    "version": "1.0.0",
    "description": "Save webpage highlights, pages, screenshots, notes, tags, and collections.",
    "permissions": ["activeTab", "scripting", "storage", "downloads", "clipboardWrite"],
    "action": {
        "default_title": "Breadcrumb",
        "default_popup": "popup.html"
    },
    "content_scripts": [
        {
            "matches": ["http://*/*", "https://*/*"],
            "js": ["content.js"],
            "css": ["content.css"],
            "run_at": "document_idle"
        }
    ]
}